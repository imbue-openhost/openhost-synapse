{
	auto_https off
}

:3000 {
	# Matrix client auto-discovery
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver":{"base_url":"PUBLIC_BASEURL_PLACEHOLDER"}}`
	}

	# Matrix federation server discovery.
	# Points remote homeservers to this server on port 443 (standard HTTPS),
	# so federation works without needing a separate port 8448.
	handle /.well-known/matrix/server {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.server":"SERVER_NAME_PLACEHOLDER:443"}`
	}

	# Admin + onboarding UI — proxy to the local Flask app.
	# zone_auth already gates all non-Matrix paths, so only the OpenHost owner
	# can reach these endpoints.
	handle /_openhost/* {
		reverse_proxy localhost:8009
	}

	# Matrix /sync long-poll cap.
	#
	# Matrix clients keep their session alive by long-polling
	# GET /_matrix/client/*/sync?timeout=<ms> (matrix-js-sdk/Cinny default 30000).
	# Synapse holds that request open for the requested duration. The OpenHost
	# router proxies app requests with a ~30s read timeout, so a sync that holds
	# the full ~30s is cut off and the client gets 504 "App timed out", which it
	# surfaces as an intermittent disconnection.
	#
	# Cap the client-requested timeout to 20s (comfortably under the router's
	# ~30s) so Synapse always responds before the router gives up. Only requests
	# that explicitly ask for >= 25s are rewritten; smaller values and the
	# initial timeout=0 sync pass through untouched (the matches() guard keeps
	# int() from erroring on absent/non-numeric values).
	@bigsync {
		path_regexp sync ^/_matrix/client/(v3|r0|unstable)/sync$
		expression {http.request.uri.query.timeout}.matches('^[0-9]+$') && int({http.request.uri.query.timeout}) >= 25000
	}
	handle @bigsync {
		uri query timeout 20000
		reverse_proxy localhost:8008 {
			header_up Host {header.X-Forwarded-Host}
		}
	}

	# Matrix client-server + federation APIs -> Synapse.
	handle /_matrix* {
		reverse_proxy localhost:8008 {
			# Rewrite the Host header from X-Forwarded-Host so that Synapse
			# sees the correct origin. The OpenHost router strips Host and
			# puts the real value in X-Forwarded-Host.
			header_up Host {header.X-Forwarded-Host}
		}
	}
	handle /_synapse* {
		reverse_proxy localhost:8008 {
			header_up Host {header.X-Forwarded-Host}
		}
	}

	# Root handler. start.sh renders this to a file_server that serves the
	# bundled Cinny SPA (falling back to index.html for client-side routing),
	# so the web client is always available at the app root. Only if the client
	# somehow isn't bundled in the image does start.sh fall back to proxying the
	# root to Synapse (bare homeserver).
	handle {
		ROOT_HANDLER_PLACEHOLDER
	}
}
